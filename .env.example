# Gym Master environment contract
# Copy this file to .env.local and fill values only in your local/hosting environment.
# Never commit .env.local, production credentials, tokens, passwords or service-role keys.

# Application URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Authentication and sessions
NEXTAUTH_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_TERMINAL_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
DRAGON_PYRAMID_LICENSE_SYNC_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email and support
BREVO_API_KEY=
BREVO_SENDER_NAME=Gym Master
BREVO_SENDER_EMAIL=no-reply@example.com
DRAGON_PYRAMID_SUPPORT_EMAIL=support@example.com
GYM_MASTER_SUPPORT_EMAIL=support@example.com
SUPPORT_EMAIL=support@example.com
GYM_MASTER_CLIENT_NAME=Gym Master
NEXT_PUBLIC_GYM_NAME=Gym Master

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ars

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_API_KEY=
CLOUDINARY_CLOUD_API_SECRET=

# Attendance defaults
GYM_MASTER_AFORO_MAXIMO=100
NEXT_PUBLIC_GYM_MASTER_AFORO_MAXIMO=100

# External Gym Master RAG Coach bridge (optional)
GYM_MASTER_RAG_COACH_URL=
GYM_MASTER_RAG_COACH_API_KEY=
GYM_MASTER_RAG_COACH_GENERATE_PATH=/api/v1/routines/generate

# YouTube Data API v3 (optional)
YOUTUBE_DATA_API_KEY=
YOUTUBE_AUTO_DISCOVERY_BATCH_SIZE=10
YOUTUBE_AUTO_DISCOVERY_REGION_ES=AR
YOUTUBE_AUTO_DISCOVERY_REGION_EN=US

# Gym Master RAG Coach foundation
RAG_ENABLED=false
RAG_VECTOR_DIMENSIONS=1536
RAG_VECTOR_TABLE=rag_document_chunk
RAG_VECTOR_RPC=match_rag_chunks
RAG_MATCH_THRESHOLD=0.72
RAG_MATCH_COUNT=8
RAG_CONTEXT_MAX_CHARS=12000
RAG_DEBUG=false
RAG_ROUTINE_MATCH_THRESHOLD=0.3
RAG_ROUTINE_MATCH_COUNT=8
RAG_DIET_MATCH_THRESHOLD=0.3
RAG_DIET_MATCH_COUNT=8
RAG_EVOLUTION_MATCH_THRESHOLD=0.3
RAG_EVOLUTION_MATCH_COUNT=8

EMBEDDING_PROVIDER=github
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_API_VERSION=2026-03-10
GITHUB_EMBEDDING_MODEL=text-embedding-3-small
GITHUB_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_FUSION=true
RAG_FUSION_QUERY_COUNT=3
RAG_ENABLE_HEURISTIC_RERANK=true
RAG_ENABLE_SAFETY_VALIDATOR=true
RAG_ENABLE_EXPLAINABILITY=true
RAG_ENABLE_TRACE=true
RAG_COACH_LANGUAGE=es-AR
RAG_COACH_TONE=empatico_motivacional
RAG_MEDICAL_DISCLAIMER_ENABLED=true
RAG_REQUIRE_HUMAN_REVIEW_FOR_HIGH_RISK=true

# Public QA/debug flags: keep false in production
NEXT_PUBLIC_EXPOSE_INTERNAL_TEST_ENDPOINTS=false
NEXT_PUBLIC_QA_FILE_BADGES=false

# Playwright E2E (local/CI only; never use production accounts)
E2E_BASE_URL=http://127.0.0.1:3000
E2E_PORT=3000
E2E_SKIP_WEBSERVER=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_ROLE=admin
E2E_SOCIO_EMAIL=
E2E_SOCIO_PASSWORD=
